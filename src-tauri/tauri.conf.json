{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A-do",
  "version": "1.0.0",
  "identifier": "com.ahmetgonkir.ado",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "A-do",
        "width": 380,
        "height": 700,
        "resizable": false,
        "decorations": true,
        "visible": false,
        "skipTaskbar": true,
        "alwaysOnTop": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Minimal menu-bar kanban board",
    "longDescription": "A-do is a lightweight kanban task manager that lives in your menu bar. Organize your work into To Do, In Progress, and Done columns — always one click away. All data stored locally.",
    "copyright": "Copyright © 2026 Ahmet Gonkir",
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "13.0",
      "providerShortName": null,
      "signingIdentity": null,
      "frameworks": [],
      "exceptionDomain": ""
    }
  }
}
